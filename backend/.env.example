DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/fitxes_tecniques
SECRET_KEY=canvia-aquesta-clau-secreta
FLASK_ENV=development

# FTP
FTP_HOST=farineracoromina.com
FTP_PORT=21
FTP_USER=usuari@farineracoromina.com
FTP_PASSWORD=
FTP_PATH=/fitxestecniques

# Carpeta xarxa (PENDENT)
NETWORK_SHARE_PATH=

# Clau de l'endpoint de denominacions que consumeix el DeCA.
# Buida = endpoint desactivat. Genera-la amb:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_DENOMINACIONS_KEY=

# Enviament de fitxes per correu (Microsoft Graph).
# Mateixa app registration que SharePoint; cal el permis d'aplicacio Mail.Send
# amb admin consent. Buit = enviament per correu desactivat.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
EMAIL_MAX_ADJUNTS=30
# Opcionals: text per defecte (buit = el del codi). {fitxes} = llista de fitxes.
EMAIL_PLANTILLA_ASSUMPTE=
EMAIL_PLANTILLA_COS=
